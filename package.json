{
  "name": "hamy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "tts:setup": "python3 -m venv scripts/.venv && scripts/.venv/bin/pip install edge-tts",
    "tts": "scripts/.venv/bin/python scripts/generate_tts.py",
    "tts:fast": "scripts/.venv/bin/python scripts/generate_tts.py --rate +15% --out text-to-speech-out/fast",
    "tts:slow": "scripts/.venv/bin/python scripts/generate_tts.py --rate -15% --out text-to-speech-out/slow",
    "tts:voices": "scripts/.venv/bin/edge-tts --list-voices | grep en-US"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.0.0",
    "@fontsource/nunito": "^5.0.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^0.1.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^4.0.0",
    "eslint-config-next": "^0.2.4",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "chrome >= 80",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "not dead"
  ]
}
